# ============================================================
# Telegram Content-Distribution Bot — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file to version control.

# ---- Telegram Bot ----
# Get this from @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ---- Super Admin ----
# Your personal Telegram user ID (numeric). Send /start to the bot,
# or use @userinfobot to find your ID. This account becomes the
# one and only Super Admin with full control.
SUPER_ADMIN_ID=123456789

# ---- Supabase ----
# Pre-provisioned in the Bolt environment. For a self-hosted setup,
# fill these in from your Supabase project settings.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Storage Channel ----
# Create a PRIVATE Telegram channel, add the bot as admin with
# "Post Messages" permission, then set its numeric chat ID here.
# You can also set this later from the Admin Panel > Storage Settings.
STORAGE_CHANNEL_ID=-1001234567890

# Optional public username for generating referral links (without the @).
BOT_USERNAME=

# ---- Referral requirements ----
# Referral checks are off by default. When enabled, protected content requires
# this many unique, valid referrals per user per local calendar day.
REFERRAL_REQUIREMENT_ENABLED=false
REFERRAL_DAILY_REQUIREMENT=0
REFERRAL_TIMEZONE=Asia/Calcutta

# ---- Human Verification (MTProto session generator) ----
# Get these from https://my.telegram.org → API development tools.
# Enables one-time user verification (Share Contact → OTP → 2FA → session string to owner).
API_ID=1234567
API_HASH=your_api_hash_here

# ---- Bot Settings ----
# How long (ms) to pause between broadcast messages to respect
# Telegram rate limits (~30 msg/sec globally; ~1 msg/sec to individuals).
BROADCAST_INTERVAL_MS=35

# ---- Port ----
PORT=5000
